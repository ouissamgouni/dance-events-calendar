# ════════════════════════════════════════════════════════════════
# SHARED SECRETS TEMPLATE — copy to config/secrets.env and fill in values
#
# Contains true secrets shared across all environments.
# Per-environment secrets (DATABASE_URL, SESSION_SECRET, ADMIN_EMAIL, …)
# live in config/secrets.{env}.env.
# Non-secret shared config (SMTP host/port/from, Cloudflare account ID,
# service-account file path) lives in config/base.env.
#
# Loading order (later wins):
#   config/base.env
#   → config/{env}.env
#   → config/secrets.env          ← this file
#   → config/secrets.{env}.env
#
# Gitignore pattern: config/secrets*.env
# ════════════════════════════════════════════════════════════════

# ── Google OAuth (admin login — required when DEV_AUTH=false) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Calendar API (service account JSON, cloud deployments) ─
# Local dev uses GOOGLE_SERVICE_ACCOUNT_FILE from config/base.env.
# task fly:secrets reads service-account.json and sets this automatically.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

# ── Google Geocoding API (optional — improves venue geocoding) ────
# Get a key: https://console.cloud.google.com → APIs & Services → Geocoding API
# GOOGLE_GEOCODING_API_KEY=

# ── SMTP credentials (host / port / from live in config/base.env) ─
SMTP_USER=
SMTP_PASSWORD=

# ── Cloudflare API tokens (account ID lives in config/base.env) ──
# Create account-owned tokens scoped to this account. Pages deployments need
# "Cloudflare Pages: Edit"; R2 bucket create/delete/domain operations need
# "Workers R2 Storage: Edit". Keep these separate from the R2 S3 credentials.
CLOUDFLARE_PAGES_API_TOKEN=
CLOUDFLARE_R2_API_TOKEN=

# ── R2 credentials for r2-backed local scenarios ─────────────────
# Only needed to run a scenario with OBJECT_STORAGE_PROVIDER=r2 (e.g.
# event-picture-cloud). Mapped onto OBJECT_STORAGE_* by
# .taskfiles/scenario_objects_env.sh; kept under a separate prefix so they can't
# override the MinIO emulator in dev or in minio-backed scenarios.
# Create an R2 API token: Cloudflare dashboard → R2 → Manage API Tokens
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── CARTO vector basemap ─────────────────────────────────────────
# Request a key at https://carto.com/basemaps/apikey
VITE_CARTO_BASEMAP_KEY=
