# ════════════════════════════════════════════════════════════════
# DEV CONFIG — committed, no secrets
#
# Dev is a scenario named "dev": its ports are pinned in
# .taskfiles/scenario_ports.sh (they are baked into vite.config.ts,
# playwright.config.ts, config/test.env and CI) and the values below must stay
# in sync with that branch.
#
# Loaded by: task start:dev, task db:migrate:dev, etc.
# Loading order: config/base.env → scenarios/dev/config.env → config/secrets.env
#                → config/secrets.dev.env
# ════════════════════════════════════════════════════════════════

ENV_NAME=dev

# ── Database (local Docker container, port 5434) ─────────────────
POSTGRES_DB=calendar_db_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# ── Ports ────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ── Object storage (MinIO emulator, port 9000 / console 9001) ────
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_BUCKET_PUBLIC=movida-dev-public
OBJECT_STORAGE_BUCKET_PRIVATE=movida-dev-private

# ── App behaviour ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
CALENDAR_SERVICE=google
DEV_AUTH=true
AUTO_SYNC_SCHEDULER_ENABLED=true
UMAMI_ENABLED=true
