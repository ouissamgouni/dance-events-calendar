# ════════════════════════════════════════════════════════════════
# Scenario: notif-milestone-email
#
# Feature : Personal Dance Passport milestone unlocks (milestone_unlocked)
# Channels: In-app + push always immediate. Email is admin-configurable
#           per feature: instant (rich per-milestone email) OR digest
#           (folds into the batched activity digest via the legacy line).
#
# When YOU unlock a milestone, the milestone service creates a self
# `milestone_unlocked` row and pushes immediately. The email delivery
# route is controlled by the admin "Milestones" box:
#   - instant OFF / digest ON (default) → email arrives via the activity
#     digest on the next scheduled/forced tick; the milestone service
#     leaves emailed_at NULL.
#   - instant ON → the milestone service sends the rich immediate email
#     right away (stamps instant_emailed_at); no schedule wait.
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_INTERVAL_MINUTES=1

# Cross-feature isolation.
EVENT_REMINDERS_ENABLED=false
INTEREST_MATCH_NOTIFICATIONS_ENABLED=false

# Milestone generation + digest email vehicle ON.
MILESTONE_NOTIFICATIONS_ENABLED=true
ACTIVITY_DIGEST_EMAIL_ENABLED=true

# Push ON so the immediate milestone push can be observed.
WEB_PUSH_ENABLED=true

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

# Local SMTP catcher — Mailpit on port 1025 (web UI: http://127.0.0.1:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
