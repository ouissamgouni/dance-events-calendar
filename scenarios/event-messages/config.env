# ════════════════════════════════════════════════════════════════
# Scenario: event-messages
#
# Feature : Event message board (Q&A / requests among attendees)
# Channels: In-app + push immediate; email via digest OR instant
#           (per-feature admin toggle — this scenario turns instant ON).
#
# Signed-in users post a top-level message (question / accommodation / ride /
# tickets / meetup / lost_found / other) or a flat reply on an event. New
# top-level posts notify everyone engaged with the event (Going ∪ Saved) plus
# the site admin, minus the author. Posting also auto-engages the author so
# they receive later activity. Replies notify that thread's participants (so
# the original author is pinged when someone answers). Users who neither saved
# nor marked Going receive nothing. Posting is blocked once the event has
# ended (the board goes read-only). Reports notify the admin in-app.
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_INTERVAL_MINUTES=1

# Cross-feature isolation — keep other notification sources quiet so the
# only rows produced are event_message / event_message_reply / reported.
EVENT_REMINDERS_ENABLED=false
INTEREST_MATCH_NOTIFICATIONS_ENABLED=false

# Digest email vehicle ON so event-message rows can roll into a digest.
ACTIVITY_DIGEST_EMAIL_ENABLED=true

# Push ON so the immediate event-message push can be observed.
WEB_PUSH_ENABLED=true

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
