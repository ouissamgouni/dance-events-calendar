# ════════════════════════════════════════════════════════════════
# Scenario: event-review-prompt  (Event Quality Layer — Phase 3)
#
# Feature : Post-event "how was it?" review nudge (REVIEW_PROMPT_ENABLED)
# Channel : In-app row + email (push follows the same per-user gate,
#           see NotificationSettings — not exercised here since it
#           requires a live browser PushSubscription).
#
# Asserts review_prompt_service creates an in-app row AND sends a
# per-event review-prompt email to each `going` attendee whose
# `email_review_prompt_enabled` toggle is true, once their event has
# ended (the fixture event is pinned to last week's Wednesday, always
# past the delay/lookback window — see db-events.yaml). A user who
# already rated the event is excluded entirely (no notification, no
# email).
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_INTERVAL_MINUTES=1

# Feature under test. The fixture event is pinned to last week's Wednesday
# (see db-events.yaml) so it's always in the past regardless of which day
# this scenario is (re)seeded on. DELAY/LOOKBACK are widened accordingly so
# the [now-delay-lookback, now-delay] window always covers "last Wednesday"
# no matter where in the current week "now" falls (up to ~13 days back).
REVIEW_PROMPT_ENABLED=true
REVIEW_PROMPT_DELAY_HOURS=96
REVIEW_PROMPT_LOOKBACK_HOURS=240

# Cross-feature isolation.
EVENT_REMINDERS_ENABLED=false
ACTIVITY_DIGEST_EMAIL_ENABLED=false
INTEREST_MATCH_NOTIFICATIONS_ENABLED=false

# Channel isolation: web-push disabled globally — this scenario only
# exercises the in-app + email channels (push uses the identical
# per-user gate pattern and is covered by backend unit tests).
WEB_PUSH_ENABLED=false

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

# Local SMTP catcher — Mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
