CALENDAR_SERVICE=mock
DEV_AUTH=true
ADMIN_EMAIL=admin@example.com
# Post-event "how was it?" prompts drive the Overview "Pending review" card
# and the /mine/reviews prompts for attended-but-unrated past events.
REVIEW_PROMPT_ENABLED=true
WEB_PUSH_ENABLED=true
# Local SMTP catcher — Mailpit on port 1025 (web UI: http://127.0.0.1:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
