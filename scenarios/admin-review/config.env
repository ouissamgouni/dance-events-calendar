# ════════════════════════════════════════════════════════════════
# Scenario: admin-review
#
# Feature : One place to eyeball every admin review state — events in each
#           status and audience, with tags and series, new events arriving
#           from a mock Google sync, and changes of every kind, source and
#           outcome in the Review panel.
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

NOTIFICATION_SCHEDULER_ENABLED=true
SCHEDULER_TICK_MINUTES=1

# Cross-feature isolation.
EVENT_REMINDERS_ENABLED=false
INTEREST_MATCH_NOTIFICATIONS_ENABLED=false
ACTIVITY_DIGEST_EMAIL_ENABLED=false

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

# Local SMTP catcher — Mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
