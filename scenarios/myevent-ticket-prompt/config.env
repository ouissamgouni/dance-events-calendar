# ════════════════════════════════════════════════════════════════
# Scenario: myevent-ticket-prompt
#
# "Got your ticket? Keep it handy here" nudge (event_ticket_prompt) for
# ticket-likely events only: international, 20h+ long, or admin-pinned.
# In-app + email (Mailpit); push is covered by backend unit tests.
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true
ADMIN_EMAIL=admin@example.com
OBJECT_STORAGE_PROVIDER=minio

NOTIFICATION_SCHEDULER_ENABLED=true
SCHEDULER_TICK_MINUTES=1

# Cross-feature isolation.
EVENT_REMINDERS_ENABLED=false
REVIEW_PROMPT_ENABLED=false
ACTIVITY_DIGEST_EMAIL_ENABLED=false
INTEREST_MATCH_NOTIFICATIONS_ENABLED=false
WEB_PUSH_ENABLED=false

PUBLIC_APP_URL=http://localhost:5173

# Local SMTP catcher — Mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
