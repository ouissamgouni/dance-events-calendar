# ════════════════════════════════════════════════════════════════
# Scenario: notif-suggested-events
#
# Feature : Suggested events (subscription_suggested) — its own feature
#           bucket (H4), split out of the broader "Friends & social"
#           (social_activity) bucket with independent email/push gates
#           email_suggested_events_enabled / push_suggested_events_enabled.
# Channels: In-app + push immediate; email folded into the combined
#           activity digest (v2).
#
# When an event a user SUBMITTED as a suggestion is approved by an
# admin, it fans out a `subscription_suggested` notification to that
# submitter's followers ("Alice suggested the event X").
# This scenario proves the new per-feature toggle controls whether that
# notification's own section appears in the combined digest email,
# independently of every other feature.
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_INTERVAL_MINUTES=1

# Cross-feature isolation.
EVENT_REMINDERS_ENABLED=false
INTEREST_MATCH_NOTIFICATIONS_ENABLED=false

# Combined digest v2 ON (default) so the suggested-events row renders as
# its own card section in one combined email.
ACTIVITY_DIGEST_EMAIL_ENABLED=true
DIGEST_V2_ENABLED=true

# Push ON so the immediate suggested-events push can be observed.
WEB_PUSH_ENABLED=true

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
