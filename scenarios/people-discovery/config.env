# ════════════════════════════════════════════════════════════════
# Scenario: people-discovery
#
# Feature : For You "Build your tribe" trail (top for small circles, 5 max +
#           See all, "Not interested" with backfill), Home people sheet
#           (cadence by friend count, after the review prompt), "someone you
#           may know joined" notifications (in-app + push), digest people
#           section with "New on Movida", admin card (settings, stats, force).
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

# Ticks are triggered by hand: `SCENARIO=people-discovery task notify:trigger:scenario`.
NOTIFICATION_SCHEDULER_ENABLED=false

PEOPLE_PROMPT_ENABLED=true
PEOPLE_JOINED_ENABLED=true
# Push at any local hour so the push step works whenever the scenario is run.
PEOPLE_JOINED_PUSH_START_HOUR=1
PEOPLE_JOINED_PUSH_END_HOUR=24

REVIEW_HOME_PROMPT_ENABLED=true
REVIEW_PROMPT_DELAY_HOURS=3

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

# Local SMTP catcher — Mailpit on port 1025 (web UI: http://127.0.0.1:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
