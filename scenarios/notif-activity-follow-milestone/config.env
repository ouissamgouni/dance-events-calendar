# ════════════════════════════════════════════════════════════════
# Scenario: notif-activity-follow-milestone
#
# Feature : Friend milestones (subscription_milestone)
# Channels: In-app + push immediate; email via digest.
#
# When someone you follow reaches a Dance Passport milestone, followers
# get a `subscription_milestone` in-app row (+ push if enabled) and the
# milestone folds into the batched activity digest email. Fan-out is
# gated by the actor's `passport_visibility`: public → notify followers,
# private → notify nobody.
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_INTERVAL_MINUTES=1

# Cross-feature isolation.
EVENT_REMINDERS_ENABLED=false
INTEREST_MATCH_NOTIFICATIONS_ENABLED=false

# Milestone generation + digest email vehicle ON.
MILESTONE_NOTIFICATIONS_ENABLED=true
ACTIVITY_DIGEST_EMAIL_ENABLED=true

# Push ON so the immediate friend-milestone push can be observed.
WEB_PUSH_ENABLED=true

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

# Local SMTP catcher — Mailpit on port 1025 (web UI: http://127.0.0.1:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
