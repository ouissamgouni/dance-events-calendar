CALENDAR_SERVICE=mock
DEV_AUTH=true
ADMIN_EMAIL=admin@example.com
# Local SMTP catcher — Mailpit on port 1025 (web UI: http://127.0.0.1:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test

# Milestone-unlock notifications need the in-app dispatch loop running so it
# generates the in-app rows (and, per-user, emails/pushes) after milestones
# unlock. Without this the loop never runs and no milestone notification fires.
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_INTERVAL_MINUTES=1
# Exercise the push channel too (still needs VAPID keys + a browser-granted
# PushSubscription for an actual device delivery).
WEB_PUSH_ENABLED=true
