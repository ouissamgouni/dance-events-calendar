# ════════════════════════════════════════════════════════════════
# Scenario: admin-notif-activity
#
# Admin → Notifications activity view. Six days of pre-seeded email/push
# delivery history (db-notifications.yaml `deliveries:`) — digests,
# instant sends, forced admin sends, user-action pushes, legacy rows
# without a source, and engagement. The scheduler is off so nothing new
# is sent while you browse.
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true
ADMIN_EMAIL=admin@example.com
OBJECT_STORAGE_PROVIDER=minio

NOTIFICATION_SCHEDULER_ENABLED=false
WEB_PUSH_ENABLED=false

PUBLIC_APP_URL=http://localhost:5173
