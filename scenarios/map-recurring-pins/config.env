# ════════════════════════════════════════════════════════════════
# Scenario: map-recurring-pins
#
# Feature : On the Explorer and Calendar maps, the dates of one recurring
#           event (same series_key + venue) collapse onto a single "×N" pin,
#           and a click on a big same-spot stack (> 8 events) opens a list
#           instead of a spider ring. Smaller stacks still spiderfy.
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true
AUTO_SYNC_ENABLED=false

ADMIN_EMAIL=admin@example.com
