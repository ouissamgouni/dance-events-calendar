# ════════════════════════════════════════════════════════════════
# Scenario: event-revisions
#
# Feature : Changes to already-published events wait for review.
#           A Google-source edit, an admin side-panel edit and a submitter's
#           edit of an approved event each become a revision; the live event
#           is unchanged until an admin applies it, and applying tells the
#           people who saved / are going exactly what changed.
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

NOTIFICATION_SCHEDULER_ENABLED=true
SCHEDULER_TICK_MINUTES=1

# Cross-feature isolation.
EVENT_REMINDERS_ENABLED=false
INTEREST_MATCH_NOTIFICATIONS_ENABLED=false
ACTIVITY_DIGEST_EMAIL_ENABLED=false

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

# Local SMTP catcher — Mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
