# ════════════════════════════════════════════════════════════════
# Scenario: review-home-prompt
#
# Feature : Home review prompt (auto-opened review wizard, once per
#           session, server-side frequency caps) + "Review then discover
#           similar events" thanks-screen rail + admin "Force Home prompt".
# Channel : In-app only — the notification scheduler is off so the Home
#           prompt is the only review nudge exercised here.
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

NOTIFICATION_SCHEDULER_ENABLED=false

REVIEW_HOME_PROMPT_ENABLED=true
# Past fixtures sit last week (always > 3h ago and < 14 days ago).
REVIEW_PROMPT_DELAY_HOURS=3

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173
