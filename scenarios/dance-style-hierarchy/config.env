# ════════════════════════════════════════════════════════════════
# Scenario: dance-style-hierarchy
#
# Salsa sub-styles (On1 / On2 / Cuban) are children of "Salsa". In a
# search profile a sub-style supersedes its parent, siblings combine,
# and "All Salsa" matches the whole family. Also covers the admin
# Search profiles view + per-user edit (in-app notice to the owner).
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

# Dispatch is triggered manually (see test_plan.yaml) for determinism.
NOTIFICATION_SCHEDULER_ENABLED=false
EVENT_REMINDERS_ENABLED=false
ACTIVITY_DIGEST_EMAIL_ENABLED=false
INTEREST_MATCH_NOTIFICATIONS_ENABLED=true

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173
