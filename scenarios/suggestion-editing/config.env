# ════════════════════════════════════════════════════════════════
# Scenario: suggestion-editing
#
# Feature : Submitters edit their own suggested events.
#           Phase 1 — events still awaiting review can be edited freely,
#           re-expanding their dates while keeping occurrence ids (and the
#           RSVPs on them) stable; submitters can withdraw; admins can lock;
#           every change lands in the suggestion's edit history.
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

WEB_PUSH_ENABLED=true

# Cross-feature isolation.
EVENT_REMINDERS_ENABLED=false
INTEREST_MATCH_NOTIFICATIONS_ENABLED=false

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173
