# ════════════════════════════════════════════════════════════════
# Scenario: notif-activity-following
#
# Feature : Friends & social activity (new_follower / new_friend)
# Channels: In-app + push immediate; email via digest.
#
# When someone follows you (new_follower) or you become mutual friends
# (new_friend), you get an in-app row immediately (+ push if enabled),
# and the activity is folded into the batched digest email. This is the
# `social_activity` feature, split apart from `friends_going`.
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_INTERVAL_MINUTES=1

# Cross-feature isolation.
EVENT_REMINDERS_ENABLED=false
INTEREST_MATCH_NOTIFICATIONS_ENABLED=false

# Digest email vehicle ON so social-activity rows can roll into a digest.
ACTIVITY_DIGEST_EMAIL_ENABLED=true

# Push ON so the immediate social-activity push can be observed.
WEB_PUSH_ENABLED=true

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
