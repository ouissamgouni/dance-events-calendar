# ════════════════════════════════════════════════════════════════
# Scenario: notif-activity-follow-review
#
# Feature : Friend reviews (subscription_review)
# Channels: In-app + push immediate; email via digest.
#
# When someone you follow drops a review, followers get a
# `subscription_review` in-app row immediately (+ push if enabled),
# and the review is folded into the batched activity digest email.
# Anonymous reviews still fan out but are masked to "Someone".
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_INTERVAL_MINUTES=1

# Cross-feature isolation.
EVENT_REMINDERS_ENABLED=false
INTEREST_MATCH_NOTIFICATIONS_ENABLED=false

# Digest email vehicle ON so friend-review rows can roll into a digest.
ACTIVITY_DIGEST_EMAIL_ENABLED=true

# Push ON so the immediate friend-review push can be observed.
WEB_PUSH_ENABLED=true

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
