# ════════════════════════════════════════════════════════════════
# Scenario: notif-prompts-digest
#
# Admin delivery channels: ticket, memories and review prompts routed to
# the batched activity digest instead of instant email (settings.yaml).
# Push stays instant; memories prompt push is switched off by the admin.
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true
ADMIN_EMAIL=admin@example.com
OBJECT_STORAGE_PROVIDER=minio

NOTIFICATION_SCHEDULER_ENABLED=true
SCHEDULER_TICK_MINUTES=1

# Features under test (delay/lookback live in settings.yaml).
REVIEW_PROMPT_ENABLED=true
ACTIVITY_DIGEST_EMAIL_ENABLED=true

# Cross-feature isolation.
EVENT_REMINDERS_ENABLED=false
INTEREST_MATCH_NOTIFICATIONS_ENABLED=false
WEB_PUSH_ENABLED=false

PUBLIC_APP_URL=http://localhost:5173

# Local SMTP catcher — Mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
