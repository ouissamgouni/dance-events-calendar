# ════════════════════════════════════════════════════════════════
# Scenario: notif-activity-friends-going
#
# Feature : Friends going (subscription_going)
# Channels: In-app + push immediate; email via digest.
#
# When a friend or follow marks Going to an event, their followers get
# a `subscription_going` in-app row immediately (+ push if enabled),
# folded into the batched digest email. A recipient who is ALSO going
# to the same event sees "You and X are going to ..." instead of
# "X is going to ...".
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_INTERVAL_MINUTES=1

# Cross-feature isolation.
EVENT_REMINDERS_ENABLED=false
INTEREST_MATCH_NOTIFICATIONS_ENABLED=false

# Digest email vehicle ON so friends-going rows can roll into a digest.
ACTIVITY_DIGEST_EMAIL_ENABLED=true

# Push ON so the immediate friends-going push can be observed.
WEB_PUSH_ENABLED=true

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
