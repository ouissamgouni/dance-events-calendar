CALENDAR_SERVICE=mock
DEV_AUTH=true
ADMIN_EMAIL=admin@example.com
# Points at REAL Cloudflare R2 instead of the MinIO emulator. Requires
# R2_ENDPOINT / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY plus
# CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID in config/secrets.env.
# OBJECT_STORAGE_PUBLIC_BASE_URL is resolved at start from the bucket's managed
# r2.dev domain — the R2 S3 endpoint itself cannot serve unsigned reads.
#
# Buckets are named movida-scenario-event-picture-cloud-{public,private} and
# are safe to delete: `task objects:destroy SCENARIO=event-picture-cloud`.
OBJECT_STORAGE_PROVIDER=r2
