# ════════════════════════════════════════════════════════════════
# Scenario: interest-matches  (all channels in one cast)
#
# Feature : Interest-profile matches      (INTEREST_MATCH_NOTIFICATIONS)
# Channels: in-app (always) + digest email + web-push, exercised
#           together via a multi-user cast.
#
# Merges the former notif-event-matches-profile-{app,email,push}
# per-channel scenarios. The matcher branch coverage (dance / reach /
# geo) is preserved; per-user channel toggles now discriminate delivery:
#   Nora  — email ON,  push OFF → in-app + email
#   Bob   — email OFF, push ON  → in-app + push (dedup probe)
#   Carol — email ON,  push ON  → in-app + email + push
#   Dan   — profile silenced    → 0 rows (feature-level negative)
#   Eve   — email OFF, push OFF → in-app only (channel negative probe)
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_INTERVAL_MINUTES=1

# Cross-feature isolation: reminders off. Digest pipeline ON — it is the
# delivery vehicle for interest_event rows on BOTH email and push.
EVENT_REMINDERS_ENABLED=false
ACTIVITY_DIGEST_EMAIL_ENABLED=true

# Feature under test.
INTEREST_MATCH_NOTIFICATIONS_ENABLED=true

# Both delivery channels enabled at the admin level; per-user toggles
# (mock-users.yaml) decide who actually receives email / push.
WEB_PUSH_ENABLED=true
VAPID_SUBJECT=mailto:admin@example.com

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

# Local SMTP catcher — Mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
