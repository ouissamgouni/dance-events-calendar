# ════════════════════════════════════════════════════════════════
# Scenario: notif-activity-digest-email  (all-features digest render)
#
# Feature : EVERY activity feature, folded into ONE digest email
# Channel : Digest email                  (in-app rows still created)
#
# One actor (Alice) generates activity across all feature buckets and a
# single follower (Bob) with every `email_*` toggle ON receives ONE
# digest email whose body lists a line for each feature:
#   friends_going      — Alice is going to an event       (subscription_going)
#   social_activity    — a new follower + a new friend     (new_follower/new_friend)
#   friend_reviews     — Alice reviewed an event           (subscription_review)
#   friend_milestones  — Alice reached a passport milestone (subscription_milestone)
#   interest_matches   — a new event matched Bob's profile  (interest_event)
# plus the "People you may want to follow" suggestions section and the
# engagement CTA block. Carol (every toggle OFF) is the negative probe.
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_INTERVAL_MINUTES=1

# Cross-feature isolation — reminders/review-prompt are unrelated here.
EVENT_REMINDERS_ENABLED=false

# All activity-feature generators ON so every line can appear.
ACTIVITY_DIGEST_EMAIL_ENABLED=true
INTEREST_MATCH_NOTIFICATIONS_ENABLED=true
MILESTONE_NOTIFICATIONS_ENABLED=true

# Push ON at the platform level, but every user has push_* OFF so the
# only outbound channel exercised here is the digest email.
WEB_PUSH_ENABLED=true

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

# Local SMTP catcher — Mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
