# ════════════════════════════════════════════════════════════════
# Scenario: event-reminders  (all channels in one cast)
#
# Feature : Event reminders           (EVENT_REMINDERS_ENABLED)
# Channels: in-app (always) + email + web-push, exercised together
#           via a multi-user cast so every channel combination and a
#           double-negative opt-out are covered by a single tick.
#
# Merges the former reminders-app / reminders-email / reminders-push
# per-channel scenarios into one truth-table cast:
#   Alice — email ON,  push OFF → in-app + email
#   Bob   — email OFF, push ON  → in-app + push (browser subscribes)
#   Carol — email ON,  push ON  → in-app + email + push
#   Dan   — email OFF, push OFF → in-app only (double negative probe)
# ════════════════════════════════════════════════════════════════
CALENDAR_SERVICE=mock
DEV_AUTH=true

NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_INTERVAL_MINUTES=1

# Feature under test.
EVENT_REMINDERS_ENABLED=true
REMINDER_LEAD_HOURS=240

# "Ask a question" CTA on reminders — a popular event (>= this many
# "Going" attendees) tags its reminder with context="ask", appends an
# ask CTA link to the reminder email, and points the in-app / push
# deep-link at /event/{id}/ask (the message board composer). ev-remind
# has 4 Going attendees (>= 3) so it qualifies; the control event does not.
EVENT_MESSAGE_CTA_MIN_GOING=3

# Cross-feature isolation.
ACTIVITY_DIGEST_EMAIL_ENABLED=false
INTEREST_MATCH_NOTIFICATIONS_ENABLED=false

# Both delivery channels enabled at the admin level; per-user toggles
# (mock-users.yaml) decide who actually receives email / push.
WEB_PUSH_ENABLED=true
VAPID_SUBJECT=mailto:admin@example.com

ADMIN_EMAIL=admin@example.com
PUBLIC_APP_URL=http://localhost:5173

# Local SMTP catcher — Mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
